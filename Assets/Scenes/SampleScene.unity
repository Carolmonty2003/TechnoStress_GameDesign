--- !u!114 &532645134
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 532645130}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fb971dd7c67d1a149ae264999e5663dc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tips:
  - type: 0
    text: "Aprovecha la calma para crear h\xE1bitos: rutinas, metas peque\xF1as y
      descansos."
    image: {fileID: -6424540784289549379, guid: f110201e3c5a0fc4ea237c49973931f5, type: 3}
  - type: 1
    text: Protege tiempo para una sola tares y silecia distracciones.
    image: {fileID: -1959289773999126988, guid: 370845d221b50b04d9b0542761e94498, type: 3}
  - type: 2
    text: "Prioriza en vez de reaccionar a todo; decir NO tambi\xE9n es organizarte."
    image: {fileID: 6234443718498604869, guid: 56ae7ab1e9e86c64cb45b29aa9a95c11, type: 3}
  - type: 3
    text: 'Un descanso no basta: pide ayuda y reduce pantallas.'
    image: {fileID: 7465609720348164085, guid: 3380abeace9edae41837284fd13625fb, type: 3}
  - type: 5
    text: "Parar a ordenar antes de actuar; reduce la hiperconexi\xF3n."
    image: {fileID: 8359658728211764743, guid: 1b3dffd1460bce74ea48a0f4b11d976b, type: 3}
  text: {fileID: 532645131}
  tipImage: {fileID: 2128455125}
